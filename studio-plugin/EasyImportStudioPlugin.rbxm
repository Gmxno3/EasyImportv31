-- ---------------------------------------------------------------- ÖLÇEK
local scaleCard = card("Ölçek", "05 / SCALE")
local function convertSelected(toScale)
	local list, skipped = positionable()
	if #list == 0 then return setStatus("Dönüştürülecek bir öğe seç." .. skipNote(skipped), COL.warn) end
	local ok = withHistory(toScale and "offset to scale" or "scale to offset", function()
		for _, e in ipairs(list) do
			local o, pw, ph = e.o, e.pw, e.ph
			local px_, py_ = px(o.Position.X, pw), px(o.Position.Y, ph)
			local w, h = px(o.Size.X, pw), px(o.Size.Y, ph)
			if toScale then
				o.Position = UDim2.new(Core.toScale(px_, pw), 0, Core.toScale(py_, ph), 0)
				o.Size = UDim2.new(Core.toScale(w, pw), 0, Core.toScale(h, ph), 0)
			else
				o.Position = UDim2.new(0, px_, 0, py_)
				o.Size = UDim2.new(0, w, 0, h)
			end
		end
	end)
	if ok then setStatus(#list .. " öğe " .. (toScale and "Offset → Scale" or "Scale → Offset") .. " çevrildi." .. skipNote(skipped), COL.ok) end
end
local scaleRow = row(scaleCard, 24)
button("UT_Scale_toScale", "Offset to Scale", scaleRow, 0.5, function() convertSelected(true) end, "primary")
button("UT_Scale_toOffset", "Scale to Offset", scaleRow, 0.5, function() convertSelected(false) end, "primary")

-- ---------------------------------------------------------------- TEMİZLE
local cleanCard = card("Temizle", "06 / TEMİZLE")
local function clearAttributes()
	local targets = selectedAll()
	if #targets == 0 then return setStatus("Öznitelikleri silinecek bir öğe seç.", COL.warn) end
	local n = 0
	local ok = withHistory("öznitelikleri temizle", function()
		for _, o in ipairs(targets) do
			for k in pairs(o:GetAttributes()) do
				o:SetAttribute(k, nil)
				n = n + 1
			end
		end
	end)
	if ok then setStatus(n .. " öznitelik silindi.", n &gt; 0 and COL.ok or COL.muted) end
end
local function clearTags()
	local targets = selectedAll()
	if #targets == 0 then return setStatus("Etiketleri silinecek bir öğe seç.", COL.warn) end
	local n = 0
	local ok = withHistory("etiketleri temizle", function()
		for _, o in ipairs(targets) do
			for _, tag in ipairs(CollectionService:GetTags(o)) do
				CollectionService:RemoveTag(o, tag)
				n = n + 1
			end
		end
	end)
	if ok then setStatus(n .. " etiket silindi.", n &gt; 0 and COL.ok or COL.muted) end
end
local cleanRow = row(cleanCard, 24)
button("UT_Attr_clear", "Remove all Attributes", cleanRow, 0.5, clearAttributes, "danger")
button("UT_Tag_clear", "Remove All Tags", cleanRow, 0.5, clearTags, "danger")

-- ---------------------------------------------------------------- seçim izleme
-- ---------------------------------------------------------------- YERLEŞİM (UILayout) (v27)
-- Seçili UI öğelerine UILayout / UIPadding / UICorner / UIStroke / UIAspectRatioConstraint ekler.
-- Mevcut varsa yenisi açılmaz, değerleri güncellenir (çift eklenmez). Geri alma: ChangeHistoryService.
local layoutCard = card("Yerleşim (UILayout)", "07 / YERLEŞİM")
local function numOf(box, dflt)
	local v = tonumber(box and box.Text or "")
	if v == nil then return dflt end
	return v
end
local function ensureChild(o, class)
	local c = o:FindFirstChildOfClass(class)
	if not c then
		c = Instance.new(class)
		c.Parent = o
	end
	return c
end
local layoutBoxes = {}
local function applyLayout(kind)
	local targets = selectedGuis()
	if #targets == 0 then return setStatus("Yerleşim eklenecek bir UI öğesi seç.", COL.warn) end
	local pad = numOf(layoutBoxes.pad, 8)
	local space = numOf(layoutBoxes.space, 6)
	local radius = numOf(layoutBoxes.radius, 8)
	local thick = numOf(layoutBoxes.stroke, 2)
	local ok = withHistory("yerleşim " .. kind, function()
		for _, o in ipairs(targets) do
			if kind == "list_v" or kind == "list_h" then
				local l = ensureChild(o, "UIListLayout")
				l.FillDirection = kind == "list_v" and Enum.FillDirection.Vertical or Enum.FillDirection.Horizontal
				l.Padding = UDim.new(0, space)
			elseif kind == "grid" then
				local g = ensureChild(o, "UIGridLayout")
				g.CellSize = UDim2.new(0, 80, 0, 80)
				g.CellPadding = UDim2.new(0, space, 0, space)
			elseif kind == "pad" then
				local p = ensureChild(o, "UIPadding")
				local v = UDim.new(0, pad)
				p.PaddingLeft, p.PaddingRight, p.PaddingTop, p.PaddingBottom = v, v, v, v
			elseif kind == "corner" then
				ensureChild(o, "UICorner").CornerRadius = UDim.new(0, radius)
			elseif kind == "stroke" then
				local st = ensureChild(o, "UIStroke")
				st.Thickness = thick
				st.Color = COL.text
			elseif kind == "aspect" then
				ensureChild(o, "UIAspectRatioConstraint").AspectRatio = 1
			end
		end
	end)
	if ok then setStatus(#targets .. " öğeye " .. kind .. " uygulandı.", COL.ok) end
end
-- Yalnızca yerleşim ve dolguyu kaldırır (köşe/çerçeve/oran tasarımın parçası olabilir; onlara dokunmaz).
local function removeLayouts()
	local targets = selectedGuis()
	if #targets == 0 then return setStatus("Yerleşimleri kaldırılacak bir öğe seç.", COL.warn) end
	local n = 0
	local ok = withHistory("yerleşimleri kaldır", function()
		for _, o in ipairs(targets) do
			for _, class in ipairs({ "UIListLayout", "UIGridLayout", "UIPadding" }) do
				local c = o:FindFirstChildOfClass(class)
				while c do
					c:Destroy()
					n = n + 1
					c = o:FindFirstChildOfClass(class)
				end
			end
		end
	end)
	if ok then setStatus(n .. " yerleşim/dolgu kaldırıldı.", n &gt; 0 and COL.ok or COL.muted) end
end
local layoutRow1 = row(layoutCard, 24)
button("UT_Layout_list_v", "Dikey liste", layoutRow1, 1 / 3, function() applyLayout("list_v") end)
button("UT_Layout_list_h", "Yatay liste", layoutRow1, 1 / 3, function() applyLayout("list_h") end)
button("UT_Layout_grid", "Izgara", layoutRow1, 1 / 3, function() applyLayout("grid") end)
local layoutRow2 = row(layoutCard, 24)
button("UT_Layout_pad", "Dolgu", layoutRow2, 1 / 3, function() applyLayout("pad") end)
button("UT_Layout_corner", "Köşe", layoutRow2, 1 / 3, function() applyLayout("corner") end)
button("UT_Layout_stroke", "Çerçeve", layoutRow2, 1 / 3, function() applyLayout("stroke") end)
local layoutRow3 = row(layoutCard, 24)
button("UT_Layout_aspect", "Oran 1:1", layoutRow3, 1 / 2, function() applyLayout("aspect") end)
button("UT_Layout_clear", "Yerleşim/dolgu kaldır", layoutRow3, 1 / 2, function() removeLayouts() end)
local layoutRow4 = row(layoutCard, 26)
layoutBoxes.pad = textbox("UT_Layout_pad_v", "8", layoutRow4, UDim2.new(0, 0, 0, 2), UDim2.new(0.25, -4, 1, -4))
layoutBoxes.space = textbox("UT_Layout_space_v", "6", layoutRow4, UDim2.new(0.25, 2, 0, 2), UDim2.new(0.25, -4, 1, -4))
layoutBoxes.radius = textbox("UT_Layout_radius_v", "8", layoutRow4, UDim2.new(0.5, 4, 0, 2), UDim2.new(0.25, -4, 1, -4))
layoutBoxes.stroke = textbox("UT_Layout_stroke_v", "2", layoutRow4, UDim2.new(0.75, 6, 0, 2), UDim2.new(0.25, -6, 1, -4))

local function refreshInfo()
	local list = selectedAll()
	if #list == 0 then
		selInfo.Text = "Seçili değil"
		selChip.Text = "YOK"
	elseif #list == 1 then
		local o = list[1]
		selInfo.Text = (o.ClassName or "?") .. " · " .. (o.Name or "?")
		selChip.Text = "SEÇİLİ"
	else
		selInfo.Text = #list .. " öğe seçili"
		selChip.Text = #list .. " SEÇİLİ"
	end
	refreshFields()
end
Selection.SelectionChanged:Connect(refreshInfo)
refreshInfo()
</ProtectedString>
    </Properties>
    <Item class="ModuleScript" referent="RBX_UITOOLS_CORE_01">
      <Properties>
        <string name="Name">UIToolsCore</string>
        <ProtectedString name="Source">-- UIToolsCore — UI Tools eklentisinin saf (Roblox'a bağımlı olmayan) hesapları.
-- Burada Instance/Enum yok: her şey düz sayı ve tablo. Test edilebilir olması için böyle tutuldu.
-- Koordinatlar piksel cinsindendir; {x, y, w, h} = sol-üst köşe + boyut.

local Core = {}

Core.ALIGN_MODES = { "left", "hcenter", "right", "top", "vcenter", "bottom" }
local VALID_ALIGN = {}
for _, m in ipairs(Core.ALIGN_MODES) do VALID_ALIGN[m] = true end

local function set(list)
	local s = {}
	for _, v in ipairs(list) do s[v] = true end
	return s
end

-- Kutu: verilen dikdörtgenlerin birleşik sınırı.
function Core.boundingBox(rects)
	local minX, minY, maxX, maxY = math.huge, math.huge, -math.huge, -math.huge
	for _, r in ipairs(rects) do
		if r.x &lt; minX then minX = r.x end
		if r.y &lt; minY then minY = r.y end
		if r.x + r.w &gt; maxX then maxX = r.x + r.w end
		if r.y + r.h &gt; maxY then maxY = r.y + r.h end
	end
	return { x = minX, y = minY, w = maxX - minX, h = maxY - minY }
end

-- Hizalama. container nil ise seçimin sınırına hizalanır. Boyut değişmez.
-- Dönüş: her öğe için yeni sol-üst {x, y}.
function Core.align(rects, mode, container)
	if not VALID_ALIGN[mode] then
		return nil, "bilinmeyen hizalama: " .. tostring(mode)
	end
	local out = {}
	if #rects == 0 then return out end
	local c = container or Core.boundingBox(rects)
	for i, r in ipairs(rects) do
		local x, y = r.x, r.y
		if mode == "left" then x = c.x
		elseif mode == "hcenter" then x = c.x + (c.w - r.w) / 2
		elseif mode == "right" then x = c.x + c.w - r.w
		elseif mode == "top" then y = c.y
		elseif mode == "vcenter" then y = c.y + (c.h - r.h) / 2
		elseif mode == "bottom" then y = c.y + c.h - r.h
		end
		out[i] = { x = x, y = y }
	end
	return out
end

-- Dağıtma (v22): en az 3 öğe. Uç öğeler yerinde kalır; aradakiler eşit boşlukla yerleşir.
-- axis: "h" (yatay, x/w) | "v" (dikey, y/h). Dönüş: her öğe için {x, y} (girdi sırası korunur).
function Core.distribute(rects, axis)
	if axis ~= "h" and axis ~= "v" then return nil, "bilinmeyen eksen: " .. tostring(axis) end
	local n = #rects
	if n &lt; 3 then return nil, "dağıtma için en az 3 öğe gerekir" end
	local pos = axis == "h" and "x" or "y"
	local size = axis == "h" and "w" or "h"
	local order = {}
	for i = 1, n do order[i] = i end
	table.sort(order, function(a, b)
		if rects[a][pos] ~= rects[b][pos] then return rects[a][pos] &lt; rects[b][pos] end
		return a &lt; b
	end)
	local first, last = rects[order[1]], rects[order[n]]
	-- boşluk = (uçtan uca açıklık - TÜM öğelerin boyutu toplamı) / boşluk sayısı
	local span = (last[pos] + last[size]) - first[pos]
	local total = 0
	for k = 1, n do total = total + rects[order[k]][size] end
	local gap = (span - total) / (n - 1)
	local out = {}
	for i, r in ipairs(rects) do out[i] = { x = r.x, y = r.y } end
	local cursor = first[pos] + first[size]
	for k = 2, n - 1 do
		local idx = order[k]
		local v = cursor + gap
		if axis == "h" then out[idx].x = v else out[idx].y = v end
		cursor = v + rects[idx][size]
	end
	return out
end

-- Izgaraya yuvarlama. step &lt;= 0 ise değere dokunmaz.
function Core.roundToGrid(v, step)
	if not step or step &lt;= 0 then return v end
	return math.floor(v / step + 0.5) * step
end

-- Ok tuşu taşıması. dx/dy piksel; step &gt; 0 ise sonuç ızgaraya oturur.
function Core.shiftRects(rects, dx, dy, step)
	local out = {}
	for i, r in ipairs(rects) do
		out[i] = { x = Core.roundToGrid(r.x + dx, step), y = Core.roundToGrid(r.y + dy, step) }
	end
	return out
end

-- Piksel -&gt; Scale. parentPx &lt;= 0 ise nil (üst öğe boyutu bilinmiyorsa dönüşüm yapılamaz).
function Core.toScale(px, parentPx)
	if not parentPx or parentPx &lt;= 0 then return nil end
	return px / parentPx
end

-- Scale -&gt; piksel.
function Core.toPixels(scale, parentPx)
	return scale * parentPx
end

-- Sınıf yetenekleri: hangi özellikler hangi sınıfta var.
local BASE = { "Name", "Position", "Size", "AnchorPoint", "Rotation", "ZIndex", "LayoutOrder",
	"Visible", "BackgroundColor3", "BackgroundTransparency", "BorderSizePixel", "BorderColor3",
	"ClipsDescendants", "AutomaticSize" }
local TEXT = { "Text", "TextColor3", "TextSize", "Font", "TextXAlignment", "TextYAlignment",
	"TextScaled", "TextWrapped", "TextTransparency", "RichText" }
local IMAGE = { "Image", "ImageColor3", "ImageTransparency", "ScaleType", "ImageRectOffset", "ImageRectSize" }
local SCROLL = { "CanvasSize", "ScrollBarThickness", "ScrollingDirection", "ScrollBarImageColor3" }
local BTN = { "AutoButtonColor", "Active", "Selectable" }

local function join(...)
	local out = {}
	for _, list in ipairs({ ... }) do
		for _, v in ipairs(list) do out[#out + 1] = v end
	end
	return out
end

Core.CLASSES = {
	Frame = { props = join(BASE) },
	CanvasGroup = { props = join(BASE, { "GroupTransparency" }) },
	ScrollingFrame = { props = join(BASE, SCROLL) },
	ViewportFrame = { props = join(BASE, { "Ambient", "LightColor" }) },
	TextLabel = { props = join(BASE, TEXT) },
	TextButton = { props = join(BASE, TEXT, BTN) },
	TextBox = { props = join(BASE, TEXT, { "PlaceholderText", "PlaceholderColor3", "ClearTextOnFocus" }) },
	ImageLabel = { props = join(BASE, IMAGE) },
	ImageButton = { props = join(BASE, IMAGE, BTN) },
}

-- Sınıf sırası: arayüzde gösterilecek liste.
Core.CLASS_ORDER = { "Frame", "TextLabel", "TextButton", "TextBox", "ImageLabel", "ImageButton",
	"ScrollingFrame", "CanvasGroup", "ViewportFrame" }

-- Sınıf değiştirme planı.
-- copy:    hedefte de olan özellikler (kaynaktan kopyalanır)
-- dropped: yalnızca kaynakta olan özellikler (kaybolur)
-- gained:  yalnızca hedefte olan özellikler (varsayılan değer alır)
-- warnings: kullanıcıya gösterilecek kayıp uyarıları
function Core.classChangePlan(fromClass, toClass)
	local src, dst = Core.CLASSES[fromClass], Core.CLASSES[toClass]
	if not src then return nil, "desteklenmeyen kaynak sınıf: " .. tostring(fromClass) end
	if not dst then return nil, "desteklenmeyen hedef sınıf: " .. tostring(toClass) end
	if fromClass == toClass then return nil, "öğe zaten " .. toClass end
	local srcSet, dstSet = set(src.props), set(dst.props)
	local plan = { copy = {}, dropped = {}, gained = {}, warnings = {} }
	for _, p in ipairs(src.props) do
		if dstSet[p] then plan.copy[#plan.copy + 1] = p
		else plan.dropped[#plan.dropped + 1] = p end
	end
	for _, p in ipairs(dst.props) do
		if not srcSet[p] then plan.gained[#plan.gained + 1] = p end
	end
	local dropSet = set(plan.dropped)
	if dropSet.Text then plan.warnings[#plan.warnings + 1] = "metin silinecek" end
	if dropSet.Image then plan.warnings[#plan.warnings + 1] = "resim silinecek" end
	if dropSet.CanvasSize then plan.warnings[#plan.warnings + 1] = "kaydırma ayarları silinecek" end
	return plan
end

-- Kaydırıcı: 0..1 arasındaki konum (frac) -&gt; [min, max] aralığında adımlı değer.
function Core.sliderToValue(frac, min, max, step)
	if frac &lt; 0 then frac = 0 elseif frac &gt; 1 then frac = 1 end
	local raw = min + frac * (max - min)
	if step and step &gt; 0 then
		raw = min + math.floor((raw - min) / step + 0.5) * step
	end
	if raw &lt; min then raw = min elseif raw &gt; max then raw = max end
	return raw
end

-- Değer -&gt; kaydırıcı konumu (0..1). Dolgu ve tutamaç için.
function Core.valueToFrac(v, min, max)
	if max &lt;= min then return 0 end
	local f = (v - min) / (max - min)
	if f &lt; 0 then return 0 elseif f &gt; 1 then return 1 end
	return f
end

-- Kaydırıcı değeri -&gt; metin (tam sayıysa ondalıksız).
function Core.formatValue(v)
	if v == math.floor(v) then return string.format("%d", v) end
	return (string.format("%.2f", v):gsub("%.?0+$", ""))
end

return Core
</ProtectedString>
      </Properties>
    </Item>
  </Item>
</roblox>