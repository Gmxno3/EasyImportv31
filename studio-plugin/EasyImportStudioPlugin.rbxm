<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4">
  <External>null</External>
  <External>nil</External>
  <Item class="Script" referent="RBX_EASYIMPORT_PLUGIN_01">
    <Properties>
      <string name="Name">EasyImportStudioPlugin</string>
      <ProtectedString name="Source">--[[
    ============================================================================
    EasyImport Studio Plugin v5 — Figma JSON + Görsel Galerisi &amp; Otomatik Eşleştirici
    ============================================================================
    v5 değişiklikleri:
      * Galeri artık ServerStorage + StarterGui'nin tamamını tarar (EasyImport_* çıktıları hariç).
      * Katman adında button/btn/buton kelimesi geçen görseller ImageButton olur (_button etiketi de çalışır).
      * Yeni sınıf etiketleri: _TextBox, _VideoFrame, _Frame (+ mevcut _ScrollingFrame, _CanvasGroup, _ViewportFrame ...).
      * Yenilenmiş premium arayüz.

    v3 değişiklikleri (FigBloxUI'den cımbızla alınanlar + kendi çözümlerimiz):

    GALERİ (görseller görünmüyor sorunu)
      * Artımlı tarama: her değişiklikte tüm kutucukları silip yeniden yaratmaz.
        (Eski sürüm Workspace'teki HER nesne eklenişinde galeriyi baştan kuruyordu;
         80 görselde sürekli yeniden yüklenip boş/titrek görünüyordu.)
      * Debounce (0.3 sn) + sadece Decal/Texture/ImageLabel/ImageButton olaylarını dinler.
      * Taranan yerler: ServerStorage, ReplicatedStorage (tam), Workspace (kök + 1 seviye
        + "Loaded"/"FigBloxUI_Images" klasörleri)  -&gt; Asset Manager "Insert" nereye
        düşerse düşsün bulunur.
      * Yüklenemeyen küçük resimlere ⏳ rozeti (moderasyon / yükleme bekliyor).
      * Boş/0 Texture'lar ve nerede kaç görsel bulunduğu tanılama olarak gösterilir.
      * Büyük galeri (alanın ~%42'si), "sadece boşta olanlar" filtresi, kullanılan
        görsellerde ✓ rozeti.

    80 GÖRSEL / ÇOK FRAME SORUNU
      * Aynı PNG'yi kullanan tüm ImageLabel'lar TEK satırda gruplanır; bir kez atarsın,
        hepsi güncellenir. (Figma tarafı zaten aynı görselleri tek PNG yapar.)
      * Kompakt 30px satırlar, "satıra tıkla -&gt; galeriden tıkla -&gt; otomatik sonraki satır".
      * Roblox tarafında da frame sadeleştirme: dolgusu/çizgisi/köşesi olmayan boş
        sarmalayıcı frame'ler silinir, çocukları yukarı taşınır (eski JSON'lar için).
      * Build sonrası otomatik eşleştirme çalışır: isim, Figma node-id sonekı ve
        tekil içerme kuralıyla.
--]]

if not plugin then
	warn("[EasyImport] Bu script bir Roblox Studio Eklentisi (Plugin) olarak çalıştırılmalıdır.")
	return
end

local Plugin = plugin
local HttpService = game:GetService("HttpService")
local ChangeHistoryService = game:GetService("ChangeHistoryService")
local StarterGui = game:GetService("StarterGui")
local Selection = game:GetService("Selection")
local ServerStorage = game:GetService("ServerStorage")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

-- &gt;&gt;&gt; GÖMÜLÜ ASİSTAN MODÜLLERİ — build_rbxmx.py üretir; ELLE DÜZENLEMEYİN &gt;&gt;&gt;
-- --- EIRaw ← assistant/runtime/lua/EIRaw.lua ---
local EIRaw = (function()
-- EasyImport Asistan — RAW ÇIKARICI (Lua / Luau — Roblox Studio)  [A2]
--
-- Girdi : plugin'in ürettiği `wispfree v9` dökümanı (format/version/name/
--         width/height/root) — Studio'ya gelen JSON'un çözülmüş tablosu.
-- Çıktı : her düğüm için bir RAW kaydı + GUI düzeyi özet.
--
-- JS (ei-raw.js) ve Python (ei_raw.py) sürümleriyle BİREBİR aynı sonucu
-- vermek ZORUNDADIR; tools/verify_extract.py bunu zorunlu tutar.
--
-- Roblox'ta:
--   local EIRaw = require(script.Parent.EIRaw)
--   local out   = EIRaw.extract(doc)          -- { nodes = {...}, gui = {...} }
--   local vec   = EIFeatures.compute(Spec, out.nodes[i])
--
-- Saf Lua 5.1 / Luau uyumlu; hiçbir Roblox API'si kullanmaz.

local EIRaw = {}

local EPS = 1e-9

-- ---------------------------------------------------------------------------
-- 1) SÖZLÜKLER — build_features.py ile AYNI SIRADA (indeks = ağırlık indeksi)
-- ---------------------------------------------------------------------------
local NAME_TOKENS = {
  "button","btn","buton","icon","close","exit","play","start","settings",
  "option","menu","back","next","prev","tab","nav","footer","header",
  "panel","bg","background","overlay","modal","popup","dialog","card",
  "slot","item","inventory","bag","shop","list","grid","scroll","content",
  "container","wrapper","divider","frame","label","text","title","desc",
  "value","count","timer","tooltip","badge","avatar","profile",
  "bar","hp","health","mana","energy","xp","level","coin","gem","gold",
  "progress","fill","loader","slider","toggle","check","reward","currency",
  "glow","ray","rays","shine","shining","sparkle","sparkles","star","stars",
  "twinkle","particle","flare","bloom","vignette","noise","grain","dust",
  "smoke","fog","ring","pulse","aura","beam","streak","gloss","shimmer",
  "glint","blur","halo","neon","emission","energy2","magic","fx","effect",
  "stud","studs","brick","civi","civili","texture","pattern",
  "isik","parlama","parilti","huzme","toz","duman","halka","efekt",
}

-- Sıralıdır — ilk eşleşme kazanır. pairs() sırası garantili olmadığı için
-- sözlük DEĞİL dizi kullanıyoruz (üç dilde aynı sonuç şart).
