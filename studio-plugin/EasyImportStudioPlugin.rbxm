gridBtn = button("UT_Grid", "", gridRow, 1, function()
	local idx = 1
	for i, v in ipairs(GRID_CYCLE) do if v == state.grid then idx = i end end
	state.grid = GRID_CYCLE[(idx % #GRID_CYCLE) + 1]
	plugin:SetSetting("UT_grid", state.grid)
	refreshGrid()
end)
